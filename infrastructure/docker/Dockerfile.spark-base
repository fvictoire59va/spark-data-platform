# Image de base Spark optimisée pour production
FROM eclipse-temurin:11-jdk-jammy AS base

# Arguments de build
ARG SPARK_VERSION=3.5.0
ARG HADOOP_VERSION=3
ARG DELTA_VERSION=3.2.0
ARG PYTHON_VERSION=3.11

# Variables d'environnement
ENV SPARK_HOME=/opt/spark
ENV PATH="${SPARK_HOME}/bin:${SPARK_HOME}/sbin:${PATH}"
ENV PYTHONPATH="${SPARK_HOME}/python:${SPARK_HOME}/python/lib/py4j-0.10.9.7-src.zip:${PYTHONPATH}"
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3

# Installation des dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    software-properties-common \
    ssh \
    net-tools \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Téléchargement et installation de Spark
RUN curl -fsSL "https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz" \
    | tar -xz -C /opt/ \
    && mv /opt/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION} ${SPARK_HOME} \
    && chmod -R 755 ${SPARK_HOME}

# Installation des JARs supplémentaires (Delta Lake, AWS, etc.)
RUN curl -fsSL "https://repo1.maven.org/maven2/io/delta/delta-spark_2.12/${DELTA_VERSION}/delta-spark_2.12-${DELTA_VERSION}.jar" \
    -o ${SPARK_HOME}/jars/delta-spark_2.12-${DELTA_VERSION}.jar \
    && curl -fsSL "https://repo1.maven.org/maven2/io/delta/delta-storage/${DELTA_VERSION}/delta-storage-${DELTA_VERSION}.jar" \
    -o ${SPARK_HOME}/jars/delta-storage-${DELTA_VERSION}.jar

# Configuration Spark par défaut
COPY conf/spark-defaults.conf ${SPARK_HOME}/conf/spark-defaults.conf
COPY conf/log4j2.properties ${SPARK_HOME}/conf/log4j2.properties

# Création des répertoires nécessaires avec bonnes permissions
RUN mkdir -p /opt/spark/logs /opt/spark/data && \
    chmod -R 777 /opt/spark/logs /opt/spark/data && \
    chmod -R 777 ${SPARK_HOME}/conf

# Création de l'utilisateur spark
RUN groupadd -r spark && useradd -r -g spark spark \
    && mkdir -p /home/spark \
    && chown -R spark:spark /home/spark ${SPARK_HOME}

# Répertoire de travail
WORKDIR ${SPARK_HOME}

USER spark

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:4040/api/v1/applications || exit 1

EXPOSE 4040 7077 8080 8081

CMD ["spark-shell"]
