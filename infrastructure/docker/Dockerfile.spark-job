# Image pour exécuter les jobs Spark
FROM spark-base:latest AS builder

USER root

# Installation des dépendances Python pour le build
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# Copie du projet
WORKDIR /app
COPY pyproject.toml poetry.lock* ./
COPY src/ ./src/

# Installation des dépendances Python
RUN pip3 install --no-cache-dir poetry \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --only main

# ============ Image finale ============
FROM spark-base:latest

USER root

# Copie des dépendances Python installées
COPY --from=builder /usr/local/lib/python3.11/dist-packages /usr/local/lib/python3.11/dist-packages

# Copie du code source
COPY --chown=spark:spark src/ /opt/spark/jobs/src/
COPY --chown=spark:spark configs/ /opt/spark/jobs/configs/

# Variables d'environnement pour les jobs
ENV PYTHONPATH="/opt/spark/jobs:${PYTHONPATH}"
ENV SPARK_JOB_CONFIG_PATH="/opt/spark/jobs/configs"

USER spark
WORKDIR /opt/spark/jobs

# Entrypoint pour soumettre les jobs
ENTRYPOINT ["spark-submit"]
CMD ["--help"]
