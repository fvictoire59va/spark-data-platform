# Configuration Airflow pour connexion Spark
# À placer dans la base PostgreSQL via les variables Airflow

AIRFLOW_CONN_SPARK_DEFAULT=spark://spark-master:7077

# Variables Airflow (à créer via l'interface)
# - environment: dev (ou local, staging, prod)
# - spark_executor_memory: 2g
# - spark_executor_cores: 2
# - spark_executor_instances: 2
